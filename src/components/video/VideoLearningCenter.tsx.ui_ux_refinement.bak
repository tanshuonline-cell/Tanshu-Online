import React from 'react';
import { Play, Lock, Clock, ArrowRight, Sparkles, GraduationCap } from 'lucide-react';
import { VideoGuide } from '../../types';
import { LATEST_VIDEOS } from '../../data/videosData';
import { useLanguage } from '../../context/LanguageContext';

interface Props {
  onOpenCatalog: () => void;
  onSelectVideo: (video: VideoGuide) => void;
  videos?: VideoGuide[];
}

export const VideoLearningCenter: React.FC<Props> = ({
  onOpenCatalog,
  onSelectVideo,
  videos = LATEST_VIDEOS,
}) => {
  const { t } = useLanguage();

  // Exactly maximum 4 featured / latest active videos for the homepage compact row
  const activeVideos = videos.filter((v) => v.isActive !== false);
  const homepageVideos = activeVideos.slice(0, 4);

  return (
    <section id="video-learning-center" className="py-10 bg-slate-50 border-b border-slate-200">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Section Header */}
        <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
          <div>
            <div className="text-[11px] font-bold uppercase tracking-wider text-blue-700 mb-1 flex items-center gap-1.5">
              <GraduationCap className="w-3.5 h-3.5 text-blue-600" />
              <span>{t('vlc.kicker', 'Practical Training & CSC Masterclasses')}</span>
            </div>
            <h2 className="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
              {t('vlc.title', 'Video Learning Center')}
            </h2>
          </div>
          <div className="flex items-center gap-3">
            <p className="text-xs text-slate-500 hidden md:block max-w-sm">
              {t('vlc.desc', 'Step-by-step video masterclasses and quick guides for daily cyber cafe operations and government portals.')}
            </p>
            <button
              onClick={onOpenCatalog}
              className="inline-flex items-center gap-1.5 text-xs font-bold text-blue-700 hover:text-blue-900 bg-white border border-slate-200 hover:border-blue-300 px-3 py-1.5 rounded-lg shadow-2xs transition-colors cursor-pointer shrink-0"
            >
              <span>{t('vlc.viewAll', 'View All Videos')}</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </button>
          </div>
        </div>

        {/* Responsive Grid: 4 cards on desktop, 3 on tablet, 2 on mobile */}
        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
          {homepageVideos.map((video) => {
            const isPremium = video.isPremium || video.accessType === 'premium';
            const price = video.price || 99;

            return (
              <div
                key={video.id}
                onClick={() => onSelectVideo(video)}
                className="group bg-white rounded-xl border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all duration-200 flex flex-col overflow-hidden cursor-pointer"
              >
                {/* Compact Thumbnail Container */}
                <div className="relative aspect-video bg-slate-900 overflow-hidden">
                  <img
                    src={
                      video.thumbnailUrl ||
                      `https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=640&q=80`
                    }
                    alt={video.title}
                    className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-black/20" />

                  {/* Duration Badge (Bottom Right) */}
                  <div className="absolute bottom-1.5 right-1.5 px-1.5 py-0.5 bg-black/80 rounded text-[10px] font-mono font-medium text-white flex items-center gap-1">
                    <Clock className="w-2.5 h-2.5 text-slate-300" />
                    <span>{video.duration}</span>
                  </div>

                  {/* Free or Premium Badge (Top Left) */}
                  <div className="absolute top-1.5 left-1.5 z-10">
                    {isPremium ? (
                      <div className="px-2 py-0.5 bg-amber-500 text-slate-950 rounded text-[9px] font-black uppercase tracking-wider flex items-center gap-1 shadow-2xs">
                        <Lock className="w-2.5 h-2.5" />
                        <span>PREMIUM • ₹{price}</span>
                      </div>
                    ) : (
                      <div className="px-2 py-0.5 bg-emerald-600 text-white rounded text-[9px] font-bold shadow-2xs">
                        FREE
                      </div>
                    )}
                  </div>
                </div>

                {/* Card Content */}
                <div className="p-3 flex-1 flex flex-col justify-between">
                  <div>
                    <div className="text-[10px] font-semibold text-slate-500 mb-1 flex items-center justify-between">
                      <span className="truncate">{video.instructor}</span>
                      {video.isSample && (
                        <span className="text-[8px] bg-slate-100 text-slate-600 px-1 py-0.5 rounded font-mono">
                          SAMPLE
                        </span>
                      )}
                    </div>
                    <h3 className="text-xs font-bold text-slate-900 group-hover:text-blue-700 transition-colors line-clamp-2 leading-snug">
                      {video.title}
                    </h3>
                  </div>

                  <div className="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
                    {isPremium ? (
                      <div className="flex items-center justify-between w-full">
                        <span className="text-[11px] font-black text-amber-700">₹{price}</span>
                        <span className="text-[10px] font-bold text-blue-700 group-hover:underline flex items-center gap-1">
                          View Details <ArrowRight className="w-3 h-3" />
                        </span>
                      </div>
                    ) : (
                      <div className="flex items-center justify-between w-full">
                        <span className="text-[10px] font-bold text-emerald-700">Free Guide</span>
                        <span className="text-[10px] font-bold text-blue-700 group-hover:underline flex items-center gap-1">
                          Watch Now <Play className="w-2.5 h-2.5 fill-current" />
                        </span>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        {/* Mobile View All CTA */}
        <div className="mt-4 text-center sm:hidden">
          <button
            onClick={onOpenCatalog}
            className="w-full py-2 bg-white border border-slate-300 text-xs font-bold text-blue-700 rounded-lg shadow-2xs flex items-center justify-center gap-1"
          >
            <span>View All Videos ({activeVideos.length})</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </button>
        </div>
      </div>
    </section>
  );
};
