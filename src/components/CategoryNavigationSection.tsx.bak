import React, { useState, useId } from 'react';
import { 
  Building2, 
  Landmark, 
  GraduationCap, 
  ShieldCheck, 
  Wrench, 
  ArrowRight, 
  ArrowLeft, 
  ExternalLink, 
  Clock, 
  CheckCircle2, 
  ChevronDown, 
  ChevronUp, 
  Search, 
  FileText, 
  IndianRupee, 
  Sparkles,
  Award
} from 'lucide-react';
import { GOVERNMENT_SERVICES } from '../data/servicesData';
import { GOVERNMENT_SCHEMES } from '../data/schemesData';
import { CONFIRMED_TOOLS } from '../data/toolsData';
import { GovernmentService, GovernmentScheme } from '../types';

import aadhaarImg from '../assets/images/srv_aadhaar_card_1793213335581.jpg';
import panImg from '../assets/images/srv_pan_card_1793213337829.jpg';
import voterImg from '../assets/images/srv_voter_id_evm_1793213338449.jpg';
import dlImg from '../assets/images/srv_driving_license_1793213339233.jpg';
import passportImg from '../assets/images/srv_passport_travel_1793213340053.jpg';
import edistrictImg from '../assets/images/srv_edistrict_portal_1793213339753.jpg';

import kisanImg from '../assets/images/scheme_pm_kisan_1793213628614.jpg';
import ayushmanImg from '../assets/images/scheme_ayushman_bharat_1793213629585.jpg';
import awasImg from '../assets/images/scheme_pm_awas_1793213630372.jpg';
import vishwakarmaImg from '../assets/images/scheme_pm_vishwakarma_1793213630511.jpg';
import eshramImg from '../assets/images/scheme_eshram_worker_1793213631564.jpg';
import sukanyaImg from '../assets/images/scheme_sukanya_samriddhi_1793213631693.jpg';

type CategoryType = 'none' | 'bihar-services' | 'central-services' | 'bihar-schemes' | 'central-schemes';

interface Props {
  onOpenAllTools: () => void;
  onScrollToTop?: () => void;
}

export const CategoryNavigationSection: React.FC<Props> = ({ onOpenAllTools, onScrollToTop }) => {
  const [activeCategory, setActiveCategory] = useState<CategoryType>('none');
  const [filterQuery, setFilterQuery] = useState<string>('');
  const [expandedServiceId, setExpandedServiceId] = useState<string | null>(null);
  const [selectedSchemeModal, setSelectedSchemeModal] = useState<GovernmentScheme | null>(null);

  // Dynamic calculations from existing verified datasets
  const biharServices = GOVERNMENT_SERVICES.filter(s => s.jurisdiction === 'bihar');
  const centralServices = GOVERNMENT_SERVICES.filter(s => s.jurisdiction !== 'bihar');
  const biharSchemes = GOVERNMENT_SCHEMES.filter(s => s.jurisdiction === 'bihar');
  const centralSchemes = GOVERNMENT_SCHEMES.filter(s => s.jurisdiction !== 'bihar');
  const allToolsCount = CONFIRMED_TOOLS.length;

  const handleSelectCategory = (cat: CategoryType) => {
    setActiveCategory(cat);
    setFilterQuery('');
    setExpandedServiceId(null);
    const element = document.getElementById('category-navigation');
    if (element) {
      const headerOffset = 70;
      const elementPosition = element.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });
    }
  };

  const handleBackToCategories = () => {
    setActiveCategory('none');
    setFilterQuery('');
  };

  const getServiceImage = (id: string) => {
    switch (id) {
      case 'aadhaar-services':
        return aadhaarImg;
      case 'pan-card-services':
        return panImg;
      case 'voter-services':
        return voterImg;
      case 'parivahan-services':
        return dlImg;
      case 'passport-seva':
        return passportImg;
      case 'edistrict-certificates':
        return edistrictImg;
      default:
        return null;
    }
  };

  const getSchemeImage = (id: string) => {
    switch (id) {
      case 'pm-kisan':
        return kisanImg;
      case 'ayushman-bharat':
        return ayushmanImg;
      case 'pm-awas-yojana':
        return awasImg;
      case 'pm-vishwakarma':
        return vishwakarmaImg;
      case 'e-shram-card':
        return eshramImg;
      case 'sukanya-samriddhi':
        return sukanyaImg;
      default:
        return null;
    }
  };

  // Filtered lists for the active category view
  const displayedServices = (activeCategory === 'bihar-services' ? biharServices : centralServices).filter(s => {
    if (!filterQuery) return true;
    const q = filterQuery.toLowerCase();
    return s.title.toLowerCase().includes(q) || s.summary.toLowerCase().includes(q) || s.category.toLowerCase().includes(q);
  });

  const displayedSchemes = (activeCategory === 'bihar-schemes' ? biharSchemes : centralSchemes).filter(s => {
    if (!filterQuery) return true;
    const q = filterQuery.toLowerCase();
    return (
      s.name.toLowerCase().includes(q) ||
      (s.hindiName && s.hindiName.toLowerCase().includes(q)) ||
      s.summary.toLowerCase().includes(q) ||
      s.ministry.toLowerCase().includes(q)
    );
  });

  return (
    <section id="category-navigation" className="py-14 bg-slate-50 border-b border-slate-200">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Section Header */}
        <div className="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
          <div>
            <div className="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-700 mb-1.5">
              <Sparkles className="w-3.5 h-3.5 text-blue-600" />
              <span>Sarkari Navigation Hub · श्रेणी अनुसार सेवाएं</span>
            </div>
            <h2 className="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              Browse by Government Category
            </h2>
          </div>
          <p className="text-xs sm:text-sm text-slate-600 max-w-xl leading-relaxed">
            Direct access to verified Bihar state services, Central citizen portals, DBT welfare schemes, and 89 online cyber cafe utility tools.
          </p>
        </div>

        {/* 5 PREMIUM CATEGORY CARDS GRID (When no category is expanded) */}
        {activeCategory === 'none' && (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 sm:gap-5">
            
            {/* CARD A: Bihar Government Services */}
            <div
              onClick={() => handleSelectCategory('bihar-services')}
              className="group bg-white rounded-2xl border border-indigo-100 p-5 shadow-xs hover:shadow-md hover:border-indigo-400 transition-all duration-200 cursor-pointer flex flex-col justify-between relative overflow-hidden"
            >
              <div className="absolute top-0 right-0 w-24 h-24 bg-indigo-50/50 rounded-full -mr-8 -mt-8 group-hover:scale-110 transition-transform duration-300 pointer-events-none" />
              <div>
                <div className="flex items-center justify-between mb-4">
                  <div className="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center border border-indigo-100/80 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-200">
                    <Building2 className="w-5 h-5" />
                  </div>
                  <span className="text-xs font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-full border border-indigo-100 tabular-nums">
                    {biharServices.length} Services
                  </span>
                </div>
                <h3 className="text-base font-bold text-slate-900 group-hover:text-indigo-700 transition-colors tracking-tight leading-snug mb-1">
                  Bihar Govt Services
                </h3>
                <p className="text-[11px] font-medium text-slate-500 mb-2">बिहार सरकारी सेवाएं</p>
                <p className="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
                  RTPS Caste, Income, Residence, Bihar Bhumi Mutation, Jamabandi, LPC &amp; EPDS Ration Card.
                </p>
              </div>

              <div className="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-indigo-600 group-hover:text-indigo-800">
                <span>Explore Bihar Services</span>
                <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>

            {/* CARD B: Central Government Services */}
            <div
              onClick={() => handleSelectCategory('central-services')}
              className="group bg-white rounded-2xl border border-blue-100 p-5 shadow-xs hover:shadow-md hover:border-blue-400 transition-all duration-200 cursor-pointer flex flex-col justify-between relative overflow-hidden"
            >
              <div className="absolute top-0 right-0 w-24 h-24 bg-blue-50/50 rounded-full -mr-8 -mt-8 group-hover:scale-110 transition-transform duration-300 pointer-events-none" />
              <div>
                <div className="flex items-center justify-between mb-4">
                  <div className="w-11 h-11 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center border border-blue-100/80 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-200">
                    <Landmark className="w-5 h-5" />
                  </div>
                  <span className="text-xs font-bold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full border border-blue-100 tabular-nums">
                    {centralServices.length} Services
                  </span>
                </div>
                <h3 className="text-base font-bold text-slate-900 group-hover:text-blue-700 transition-colors tracking-tight leading-snug mb-1">
                  Central Govt Services
                </h3>
                <p className="text-[11px] font-medium text-slate-500 mb-2">केंद्रीय सरकारी सेवाएं</p>
                <p className="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
                  Aadhaar PVC &amp; Updates, PAN Card, Voter Portal, Parivahan Driving License &amp; Passport Seva.
                </p>
              </div>

              <div className="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600 group-hover:text-blue-800">
                <span>Explore Central Services</span>
                <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>

            {/* CARD C: Bihar Government Schemes */}
            <div
              onClick={() => handleSelectCategory('bihar-schemes')}
              className="group bg-white rounded-2xl border border-emerald-100 p-5 shadow-xs hover:shadow-md hover:border-emerald-400 transition-all duration-200 cursor-pointer flex flex-col justify-between relative overflow-hidden"
            >
              <div className="absolute top-0 right-0 w-24 h-24 bg-emerald-50/50 rounded-full -mr-8 -mt-8 group-hover:scale-110 transition-transform duration-300 pointer-events-none" />
              <div>
                <div className="flex items-center justify-between mb-4">
                  <div className="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center border border-emerald-100/80 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-200">
                    <GraduationCap className="w-5 h-5" />
                  </div>
                  <span className="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-100 tabular-nums">
                    {biharSchemes.length} Schemes
                  </span>
                </div>
                <h3 className="text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors tracking-tight leading-snug mb-1">
                  Bihar Govt Schemes
                </h3>
                <p className="text-[11px] font-medium text-slate-500 mb-2">बिहार सरकारी योजनाएं</p>
                <p className="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
                  Mukhyamantri Udyami Yojana (₹10L), Student Credit Card, Kanya Utthan, KYP &amp; Diesel Anudan.
                </p>
              </div>

              <div className="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-600 group-hover:text-emerald-800">
                <span>Explore Bihar Schemes</span>
                <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>

            {/* CARD D: Central Government Schemes */}
            <div
              onClick={() => handleSelectCategory('central-schemes')}
              className="group bg-white rounded-2xl border border-amber-100 p-5 shadow-xs hover:shadow-md hover:border-amber-400 transition-all duration-200 cursor-pointer flex flex-col justify-between relative overflow-hidden"
            >
              <div className="absolute top-0 right-0 w-24 h-24 bg-amber-50/50 rounded-full -mr-8 -mt-8 group-hover:scale-110 transition-transform duration-300 pointer-events-none" />
              <div>
                <div className="flex items-center justify-between mb-4">
                  <div className="w-11 h-11 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center border border-amber-100/80 group-hover:bg-amber-600 group-hover:text-white transition-colors duration-200">
                    <ShieldCheck className="w-5 h-5" />
                  </div>
                  <span className="text-xs font-bold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-100 tabular-nums">
                    {centralSchemes.length} Schemes
                  </span>
                </div>
                <h3 className="text-base font-bold text-slate-900 group-hover:text-amber-700 transition-colors tracking-tight leading-snug mb-1">
                  Central Govt Schemes
                </h3>
                <p className="text-[11px] font-medium text-slate-500 mb-2">केंद्रीय सरकारी योजनाएं</p>
                <p className="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
                  PM Kisan Samman Nidhi, Ayushman Bharat (₹5 Lakh), PM Awas Yojana &amp; PM Vishwakarma.
                </p>
              </div>

              <div className="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-amber-700 group-hover:text-amber-900">
                <span>Explore Central Schemes</span>
                <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>

            {/* CARD E: All Online Tools */}
            <div
              onClick={onOpenAllTools}
              className="group bg-white rounded-2xl border border-slate-200 p-5 shadow-xs hover:shadow-md hover:border-blue-500 transition-all duration-200 cursor-pointer flex flex-col justify-between relative overflow-hidden"
            >
              <div className="absolute top-0 right-0 w-24 h-24 bg-slate-100/70 rounded-full -mr-8 -mt-8 group-hover:scale-110 transition-transform duration-300 pointer-events-none" />
              <div>
                <div className="flex items-center justify-between mb-4">
                  <div className="w-11 h-11 rounded-xl bg-slate-100 text-slate-800 flex items-center justify-center border border-slate-200 group-hover:bg-slate-900 group-hover:text-white transition-colors duration-200">
                    <Wrench className="w-5 h-5" />
                  </div>
                  <span className="text-xs font-bold text-slate-800 bg-slate-100 px-2.5 py-1 rounded-full border border-slate-200 tabular-nums">
                    {allToolsCount} Tools
                  </span>
                </div>
                <h3 className="text-base font-bold text-slate-900 group-hover:text-blue-700 transition-colors tracking-tight leading-snug mb-1">
                  All Online Tools
                </h3>
                <p className="text-[11px] font-medium text-slate-500 mb-2">सभी ऑनलाइन टूल्स</p>
                <p className="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
                  Passport photo maker, PVC card layout, PDF converter, Hindi typing &amp; cyber cafe utilities.
                </p>
              </div>

              <div className="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-blue-600 group-hover:text-blue-800">
                <span>Explore All Tools</span>
                <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>

          </div>
        )}

        {/* DEDICATED CATEGORY LISTING VIEW (When a category is active) */}
        {activeCategory !== 'none' && (
          <div className="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
            
            {/* Listing View Top Controls Bar */}
            <div className="p-4 sm:p-6 border-b border-slate-200 bg-slate-50/70 flex flex-col md:flex-row md:items-center justify-between gap-4">
              
              <div className="flex items-center gap-3">
                <button
                  onClick={handleBackToCategories}
                  className="inline-flex items-center gap-2 px-3.5 py-2 bg-white hover:bg-slate-100 text-slate-800 border border-slate-200 rounded-xl text-xs font-bold transition-all shadow-2xs hover:border-slate-300"
                >
                  <ArrowLeft className="w-4 h-4 text-slate-600" />
                  <span>Back to Categories</span>
                </button>

                <div>
                  <h3 className="text-lg sm:text-xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
                    {activeCategory === 'bihar-services' && 'Bihar Government Services (बिहार सरकारी सेवाएं)'}
                    {activeCategory === 'central-services' && 'Central Government Services (केंद्रीय सरकारी सेवाएं)'}
                    {activeCategory === 'bihar-schemes' && 'Bihar Government Schemes (बिहार सरकारी योजनाएं)'}
                    {activeCategory === 'central-schemes' && 'Central Government Schemes (केंद्रीय सरकारी योजनाएं)'}
                  </h3>
                  <p className="text-xs text-slate-500">
                    {activeCategory.includes('services') 
                      ? `Showing ${displayedServices.length} of ${activeCategory === 'bihar-services' ? biharServices.length : centralServices.length} official services with full application details`
                      : `Showing ${displayedSchemes.length} of ${activeCategory === 'bihar-schemes' ? biharSchemes.length : centralSchemes.length} national & state welfare schemes`}
                  </p>
                </div>
              </div>

              {/* Category Quick Switcher Tabs */}
              <div className="flex flex-wrap items-center gap-1.5 p-1 bg-slate-200/60 rounded-xl">
                <button
                  onClick={() => handleSelectCategory('bihar-services')}
                  className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors ${
                    activeCategory === 'bihar-services' ? 'bg-white text-indigo-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900'
                  }`}
                >
                  Bihar Services ({biharServices.length})
                </button>
                <button
                  onClick={() => handleSelectCategory('central-services')}
                  className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors ${
                    activeCategory === 'central-services' ? 'bg-white text-blue-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900'
                  }`}
                >
                  Central Services ({centralServices.length})
                </button>
                <button
                  onClick={() => handleSelectCategory('bihar-schemes')}
                  className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors ${
                    activeCategory === 'bihar-schemes' ? 'bg-white text-emerald-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900'
                  }`}
                >
                  Bihar Schemes ({biharSchemes.length})
                </button>
                <button
                  onClick={() => handleSelectCategory('central-schemes')}
                  className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors ${
                    activeCategory === 'central-schemes' ? 'bg-white text-amber-700 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900'
                  }`}
                >
                  Central Schemes ({centralSchemes.length})
                </button>
                <button
                  onClick={onOpenAllTools}
                  className="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 rounded-lg hover:bg-white/60 transition-colors"
                >
                  Tools ({allToolsCount})
                </button>
              </div>

            </div>

            {/* Search filter within active category */}
            <div className="px-4 sm:px-6 py-3 border-b border-slate-100 bg-white">
              <div className="relative max-w-md">
                <Search className="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
                <input
                  type="text"
                  value={filterQuery}
                  onChange={(e) => setFilterQuery(e.target.value)}
                  placeholder={`Search in ${activeCategory.replace('-', ' ')}...`}
                  className="w-full pl-9 pr-4 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-500 transition-colors text-slate-800 placeholder-slate-400"
                />
                {filterQuery && (
                  <button
                    onClick={() => setFilterQuery('')}
                    className="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-slate-600"
                  >
                    Clear
                  </button>
                )}
              </div>
            </div>

            {/* LIST OF SERVICES (When activeCategory is bihar-services or central-services) */}
            {activeCategory.includes('services') && (
              <div className="p-4 sm:p-6 space-y-3.5">
                {displayedServices.length === 0 ? (
                  <div className="py-12 text-center text-slate-500 text-xs">
                    No services matched "{filterQuery}". Try a different keyword or{' '}
                    <button onClick={() => setFilterQuery('')} className="text-blue-600 underline font-semibold">
                      clear filter
                    </button>.
                  </div>
                ) : (
                  displayedServices.map((srv) => {
                    const isExpanded = expandedServiceId === srv.id;
                    const serviceImg = getServiceImage(srv.id);

                    return (
                      <div
                        key={srv.id}
                        className="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-2xs hover:border-blue-300 transition-all duration-200"
                      >
                        {/* Header Row */}
                        <div
                          onClick={() => setExpandedServiceId(isExpanded ? null : srv.id)}
                          className="p-3.5 sm:p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 cursor-pointer select-none bg-white hover:bg-slate-50/80 transition-colors"
                        >
                          <div className="flex items-center gap-3 sm:gap-4 min-w-0 flex-1">
                            {serviceImg ? (
                              <div className="w-20 sm:w-28 h-14 sm:h-16 shrink-0 rounded-lg overflow-hidden border border-slate-200 bg-slate-100 relative">
                                <img
                                  src={serviceImg}
                                  alt={srv.title}
                                  referrerPolicy="no-referrer"
                                  className="w-full h-full object-cover object-center"
                                />
                              </div>
                            ) : (
                              <div className="w-12 h-12 sm:w-14 sm:h-14 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-700 shrink-0">
                                <Building2 className="w-6 h-6" />
                              </div>
                            )}

                            <div className="min-w-0 flex-1 space-y-0.5">
                              <div className="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[11px] font-semibold text-slate-500">
                                <span className={srv.jurisdiction === 'bihar' ? 'text-indigo-700 font-bold' : 'text-blue-700 font-bold'}>
                                  {srv.jurisdiction === 'bihar' ? 'Bihar State' : 'Central Portal'} · {srv.category}
                                </span>
                                <span aria-hidden="true" className="text-slate-300">·</span>
                                <span className="flex items-center gap-1 text-slate-600">
                                  <Clock className="w-3 h-3 text-slate-400 shrink-0" /> {srv.processingTime}
                                </span>
                                <span aria-hidden="true" className="text-slate-300 hidden sm:inline">·</span>
                                <span className="text-emerald-700 font-medium">Fee: {srv.estimatedFee}</span>
                              </div>
                              <h4 className="text-sm sm:text-base font-bold text-slate-900 tracking-tight">
                                {srv.title}
                              </h4>
                            </div>
                          </div>

                          <div className="flex items-center justify-end sm:justify-start gap-2.5 shrink-0 self-end sm:self-center">
                            <a
                              href={srv.officialPortal}
                              target="_blank"
                              rel="noopener noreferrer"
                              onClick={(e) => e.stopPropagation()}
                              className="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg text-xs font-semibold transition-colors border border-blue-200/60"
                            >
                              <span>Official Portal</span>
                              <ExternalLink className="w-3 h-3" />
                            </a>
                            <button
                              type="button"
                              aria-label={isExpanded ? "Collapse details" : "Expand details"}
                              className="p-1.5 text-slate-400 hover:text-slate-600 rounded-lg bg-slate-50 hover:bg-slate-100 transition-colors"
                            >
                              {isExpanded ? <ChevronUp className="w-4 h-4 text-blue-600" /> : <ChevronDown className="w-4 h-4" />}
                            </button>
                          </div>
                        </div>

                        {/* Expanded Service Content */}
                        {isExpanded && (
                          <div className="px-5 pb-5 pt-2 border-t border-slate-100 bg-slate-50/40 space-y-4 text-xs">
                            <p className="text-slate-600 leading-relaxed">{srv.summary}</p>

                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                              <div className="space-y-3">
                                <div className="bg-white p-3.5 rounded-xl border border-slate-200">
                                  <h5 className="font-bold text-slate-900 mb-2 uppercase tracking-wider text-[11px] text-blue-900">
                                    Eligibility Criteria
                                  </h5>
                                  <ul className="space-y-1.5 text-slate-600">
                                    {srv.eligibility.map((el, i) => (
                                      <li key={i} className="flex items-start gap-2">
                                        <span className="text-blue-600 font-bold">·</span>
                                        <span>{el}</span>
                                      </li>
                                    ))}
                                  </ul>
                                </div>

                                <div className="bg-white p-3.5 rounded-xl border border-slate-200">
                                  <h5 className="font-bold text-slate-900 mb-2 uppercase tracking-wider text-[11px] text-blue-900">
                                    Required Documents
                                  </h5>
                                  <ul className="space-y-1.5 text-slate-600">
                                    {srv.requiredDocuments.map((doc, i) => (
                                      <li key={i} className="flex items-start gap-2">
                                        <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                                        <span>{doc}</span>
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              </div>

                              <div className="bg-white p-3.5 rounded-xl border border-slate-200 flex flex-col justify-between">
                                <div>
                                  <h5 className="font-bold text-slate-900 mb-2.5 uppercase tracking-wider text-[11px] text-blue-900">
                                    Step-by-Step Application Procedure
                                  </h5>
                                  <ol className="space-y-2 text-slate-600">
                                    {srv.steps.map((st, i) => (
                                      <li key={i} className="flex items-start gap-2">
                                        <span className="w-4 h-4 rounded-full bg-blue-100 text-blue-800 font-bold flex items-center justify-center shrink-0 text-[10px]">
                                          {i + 1}
                                        </span>
                                        <span>{st}</span>
                                      </li>
                                    ))}
                                  </ol>
                                </div>

                                <div className="pt-3 mt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
                                  {srv.trackUrl && (
                                    <a
                                      href={srv.trackUrl}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      className="text-xs font-semibold text-blue-700 hover:underline flex items-center gap-1"
                                    >
                                      <span>Track Application</span>
                                      <ExternalLink className="w-3 h-3" />
                                    </a>
                                  )}
                                  <a
                                    href={srv.officialPortal}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    className="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold transition-colors shadow-2xs ml-auto flex items-center gap-1"
                                  >
                                    <span>Proceed to {srv.officialPortalName}</span>
                                    <ExternalLink className="w-3 h-3" />
                                  </a>
                                </div>
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                    );
                  })
                )}
              </div>
            )}

            {/* LIST OF SCHEMES (When activeCategory is bihar-schemes or central-schemes) */}
            {activeCategory.includes('schemes') && (
              <div className="p-4 sm:p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                {displayedSchemes.length === 0 ? (
                  <div className="col-span-full py-12 text-center text-slate-500 text-xs">
                    No schemes matched "{filterQuery}". Try a different keyword or{' '}
                    <button onClick={() => setFilterQuery('')} className="text-blue-600 underline font-semibold">
                      clear filter
                    </button>.
                  </div>
                ) : (
                  displayedSchemes.map((scheme) => {
                    const schemeImg = getSchemeImage(scheme.id);

                    return (
                      <div
                        key={scheme.id}
                        className="bg-white border border-slate-200 rounded-xl p-4 shadow-xs hover:border-blue-400 hover:shadow-md transition-all flex flex-col justify-between"
                      >
                        <div>
                          <div className="flex items-start justify-between gap-3 mb-2.5">
                            <div className="min-w-0 flex-1">
                              <span className="text-[10px] font-bold text-blue-700 uppercase tracking-wider block mb-0.5 line-clamp-1">
                                {scheme.ministry}
                              </span>
                              <h4 className="text-sm font-bold text-slate-900 tracking-tight leading-snug">
                                {scheme.name}
                              </h4>
                              {scheme.hindiName && (
                                <p className="text-[11px] text-slate-500 line-clamp-1 mt-0.5">
                                  {scheme.hindiName}
                                </p>
                              )}
                            </div>

                            {schemeImg ? (
                              <div className="w-16 h-12 rounded-lg overflow-hidden border border-slate-200 bg-slate-100 shrink-0">
                                <img
                                  src={schemeImg}
                                  alt={scheme.name}
                                  referrerPolicy="no-referrer"
                                  className="w-full h-full object-cover"
                                />
                              </div>
                            ) : (
                              <div className="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-100">
                                <Award className="w-5 h-5" />
                              </div>
                            )}
                          </div>

                          <div className="p-2.5 bg-emerald-50/70 border border-emerald-100 rounded-lg text-xs text-emerald-950 mb-3">
                            <span className="text-[10px] font-bold uppercase tracking-wider text-emerald-800 block">
                              Financial Benefit
                            </span>
                            <p className="font-semibold text-slate-900 line-clamp-2">{scheme.financialBenefit}</p>
                          </div>

                          <p className="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-3">
                            {scheme.summary}
                          </p>

                          <div className="text-[11px] text-slate-500 pt-2 border-t border-slate-100 mb-3">
                            <span className="font-semibold text-slate-700">Target:</span>{' '}
                            <span className="line-clamp-1">{scheme.targetBeneficiaries}</span>
                          </div>
                        </div>

                        <div className="flex items-center gap-2 pt-2 border-t border-slate-100">
                          <button
                            onClick={() => setSelectedSchemeModal(scheme)}
                            className="flex-1 py-1.5 px-3 bg-slate-900 hover:bg-blue-600 text-white rounded-lg text-xs font-semibold transition-colors text-center cursor-pointer"
                          >
                            View Eligibility &amp; Steps
                          </button>
                          <a
                            href={scheme.officialPortal}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="p-1.5 text-slate-600 hover:text-blue-600 bg-slate-100 hover:bg-blue-50 rounded-lg transition-colors"
                            title="Official Portal"
                          >
                            <ExternalLink className="w-4 h-4" />
                          </a>
                        </div>
                      </div>
                    );
                  })
                )}
              </div>
            )}

            {/* Bottom Actions Bar */}
            <div className="p-4 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3 text-xs">
              <button
                onClick={handleBackToCategories}
                className="inline-flex items-center gap-1.5 text-slate-700 hover:text-blue-700 font-semibold"
              >
                <ArrowLeft className="w-3.5 h-3.5" />
                <span>Return to 5 Category Cards</span>
              </button>

              <div className="flex items-center gap-4">
                <button
                  onClick={onOpenAllTools}
                  className="text-blue-700 hover:underline font-semibold"
                >
                  View All {allToolsCount} Tools Directory →
                </button>
                {onScrollToTop && (
                  <button
                    onClick={onScrollToTop}
                    className="text-slate-500 hover:text-slate-800"
                  >
                    Top of Page ↑
                  </button>
                )}
              </div>
            </div>

          </div>
        )}

      </div>

      {/* Scheme Detail Walkthrough Modal */}
      {selectedSchemeModal && (
        <div className="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="relative w-full max-w-3xl bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden my-auto max-h-[90vh] flex flex-col">
            <div className="p-5 sm:p-6 border-b border-slate-200 flex justify-between items-start gap-4">
              <div className="min-w-0 flex-1">
                <span className="text-xs font-semibold text-blue-700 block mb-1">
                  {selectedSchemeModal.ministry}
                </span>
                <h3 className="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
                  {selectedSchemeModal.name}
                </h3>
                {selectedSchemeModal.hindiName && (
                  <div className="text-xs text-slate-500 mt-0.5">{selectedSchemeModal.hindiName}</div>
                )}
              </div>
              <button
                onClick={() => setSelectedSchemeModal(null)}
                className="text-slate-400 hover:text-slate-700 p-1 text-lg font-bold shrink-0"
              >
                ✕
              </button>
            </div>

            <div className="p-5 sm:p-6 overflow-y-auto space-y-4 text-xs text-slate-700">
              <div className="p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl space-y-1">
                <span className="font-bold text-emerald-900 uppercase tracking-wider text-[10px] block">
                  Financial Assistance / Grant
                </span>
                <p className="font-bold text-sm text-emerald-950">{selectedSchemeModal.financialBenefit}</p>
              </div>

              <div>
                <h4 className="font-bold text-slate-900 mb-1.5 uppercase tracking-wider text-[11px] text-blue-900">
                  Scheme Overview
                </h4>
                <p className="leading-relaxed text-slate-600">{selectedSchemeModal.summary}</p>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div className="bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <h4 className="font-bold text-slate-900 mb-2 uppercase tracking-wider text-[11px] text-blue-900">
                    Who is Eligible?
                  </h4>
                  <ul className="space-y-1.5 text-slate-600">
                    {selectedSchemeModal.eligibility.map((el, i) => (
                      <li key={i} className="flex items-start gap-1.5">
                        <span className="text-blue-600 font-bold">·</span>
                        <span>{el}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div className="bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <h4 className="font-bold text-slate-900 mb-2 uppercase tracking-wider text-[11px] text-blue-900">
                    Mandatory Documents
                  </h4>
                  <ul className="space-y-1.5 text-slate-600">
                    {selectedSchemeModal.documentsRequired.map((doc, i) => (
                      <li key={i} className="flex items-start gap-1.5">
                        <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0 mt-0.5" />
                        <span>{doc}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div className="bg-slate-50 p-4 rounded-xl border border-slate-200">
                <h4 className="font-bold text-slate-900 mb-2 uppercase tracking-wider text-[11px] text-blue-900">
                  How to Apply Step-by-Step
                </h4>
                <ol className="space-y-2 text-slate-600">
                  {selectedSchemeModal.howToApply.map((step, i) => (
                    <li key={i} className="flex items-start gap-2">
                      <span className="w-4 h-4 rounded-full bg-blue-100 text-blue-800 font-bold flex items-center justify-center shrink-0 text-[10px]">
                        {i + 1}
                      </span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>

            <div className="p-4 bg-slate-50 border-t border-slate-200 flex justify-between items-center">
              <button
                onClick={() => setSelectedSchemeModal(null)}
                className="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-xs font-semibold cursor-pointer"
              >
                Close
              </button>
              <a
                href={selectedSchemeModal.officialPortal}
                target="_blank"
                rel="noopener noreferrer"
                className="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 shadow-2xs"
              >
                <span>Apply on Official Portal</span>
                <ExternalLink className="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>
      )}

    </section>
  );
};
