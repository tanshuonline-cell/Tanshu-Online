import React, { useState, useEffect } from 'react';
import { Play, Clock, Video, BookOpen, X, Check } from 'lucide-react';
import { LATEST_VIDEOS } from '../data/videosData';
import { VideoGuide } from '../types';
import { useLanguage } from '../context/LanguageContext';

interface Props {
  selectedVideoModal?: VideoGuide | null;
  onCloseModal?: () => void;
}

export const LatestVideos: React.FC<Props> = ({ selectedVideoModal, onCloseModal }) => {
  const [activeVideo, setActiveVideo] = useState<VideoGuide | null>(null);
  const { t } = useLanguage();

  useEffect(() => {
    if (selectedVideoModal) {
      setActiveVideo(selectedVideoModal);
      const element = document.getElementById(`video-${selectedVideoModal.id}`);
      if (element) {
        element.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  }, [selectedVideoModal]);

  const handleClose = () => {
    setActiveVideo(null);
    if (onCloseModal) onCloseModal();
  };

  return (
    <section id="videos" className="py-16 bg-slate-50 border-b border-slate-200">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Section Header */}
        <div className="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
          <div>
            <div className="text-xs font-bold uppercase tracking-wider text-blue-700 mb-1">
              {t('videos.kicker', 'Practical Video Tutorials & Masterclasses')}
            </div>
            <h2 className="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              {t('videos.title', 'Latest Videos & Guides')}
            </h2>
          </div>
          <p className="text-xs text-slate-500 max-w-lg">
            {t(
              'videos.desc',
              'Master photo paper printing, PVC card printer tray calibrations, exam form dimension adjustments, and cyber cafe customer management.'
            )}
          </p>
        </div>

        {/* Video Cards Grid — Six Cards Per Row on Wide Desktop */}
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3.5 sm:gap-4">
          {LATEST_VIDEOS.map((video) => (
            <div
              key={video.id}
              id={`video-${video.id}`}
              className="bg-gradient-to-b from-slate-50/70 via-white to-slate-50/40 border border-slate-200/90 rounded-2xl overflow-hidden shadow-xs hover:shadow-xl hover:border-red-400 hover:-translate-y-1.5 active:scale-[0.99] transition-all duration-300 ease-out flex flex-col justify-between group select-none"
            >
              <div>
                {/* Video Mock Thumbnail / Player Banner */}
                <div
                  onClick={() => setActiveVideo(video)}
                  className="relative aspect-video bg-slate-900 flex items-center justify-center cursor-pointer overflow-hidden"
                >
                  {/* Subtle gradient pattern */}
                  <div className="absolute inset-0 bg-gradient-to-br from-red-950/60 via-slate-900 to-slate-950 opacity-90 group-hover:scale-105 transition-transform duration-300" />
                  
                  {/* Center Play Button */}
                  <div className="relative z-10 w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center shadow-md group-hover:bg-red-500 group-hover:scale-110 transition-all">
                    <Play className="w-4 h-4 fill-current ml-0.5" />
                  </div>

                  {/* Duration Badge */}
                  <div className="absolute bottom-2 right-2 z-10 px-1.5 py-0.5 bg-black/80 rounded text-[10px] font-mono font-medium text-white flex items-center gap-1">
                    <Clock className="w-2.5 h-2.5 text-slate-300" />
                    <span>{video.duration}</span>
                  </div>

                  {/* Category */}
                  <div className="absolute top-2 left-2 z-10 px-2 py-0.5 bg-slate-950/80 border border-slate-700/60 rounded text-[9px] font-bold text-red-300">
                    {video.category}
                  </div>
                </div>

                <div className="p-3 sm:p-3.5">
                  <div className="text-[10px] sm:text-[11px] font-semibold text-slate-500 mb-0.5 truncate">
                    By {video.instructor}
                  </div>

                  <h3
                    onClick={() => setActiveVideo(video)}
                    className="text-xs sm:text-sm font-extrabold text-slate-900 tracking-tight mb-1 group-hover:text-red-700 transition-colors cursor-pointer line-clamp-2 leading-snug"
                  >
                    {video.title}
                  </h3>

                  <p className="text-[11px] text-slate-600 line-clamp-2 leading-relaxed mb-2.5">
                    {video.description}
                  </p>

                  {/* Key Takeaways */}
                  <div className="pt-2 border-t border-slate-100 mb-2">
                    <span className="text-[9px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
                      Key Takeaways:
                    </span>
                    <ul className="space-y-0.5 text-[10px] sm:text-[11px] text-slate-600">
                      {video.topics.slice(0, 2).map((top, idx) => (
                        <li key={idx} className="flex items-center gap-1.5 truncate">
                          <span className="w-1.5 h-1.5 rounded-full bg-red-600 shrink-0" />
                          <span className="truncate">{top}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <div className="p-3 sm:p-3.5 pt-0">
                <button
                  onClick={() => setActiveVideo(video)}
                  className="w-full flex items-center justify-center gap-1.5 py-2 px-3 bg-slate-900 hover:bg-red-600 text-white rounded-xl text-xs font-semibold tracking-wide transition-colors cursor-pointer shadow-2xs"
                >
                  <Play className="w-3 h-3 fill-current" />
                  <span>Watch Tutorial</span>
                </button>
              </div>
            </div>
          ))}
        </div>

        {/* Video Player & Notes Modal */}
        {activeVideo && (
          <div className="fixed inset-0 z-50 overflow-y-auto bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-4">
            <div className="relative w-full max-w-3xl bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden my-auto max-h-[92vh] flex flex-col">
              {/* Top Header */}
              <div className="p-4 px-6 border-b border-slate-200 flex justify-between items-center bg-white">
                <div className="flex items-center gap-2">
                  <span className="text-xs font-semibold text-blue-700">{activeVideo.category}</span>
                  <span className="text-slate-300">·</span>
                  <span className="text-xs text-slate-500 font-mono">{activeVideo.duration}</span>
                </div>
                <button
                  onClick={handleClose}
                  className="p-1 text-slate-400 hover:text-slate-700 rounded-lg cursor-pointer"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              {/* Video Player Simulator */}
              <div className="aspect-video bg-black flex flex-col items-center justify-center text-white relative p-6">
                <div className="w-16 h-16 rounded-full bg-blue-600 flex items-center justify-center shadow-lg mb-4 animate-pulse">
                  <Play className="w-7 h-7 fill-current ml-1" />
                </div>
                <h4 className="text-base font-bold text-center max-w-lg mb-1">{activeVideo.title}</h4>
                <p className="text-xs text-slate-400 text-center">Interactive Tutorial Streaming Stream (1080p HD)</p>

                {/* Progress bar */}
                <div className="absolute inset-x-0 bottom-0 h-1.5 bg-slate-800">
                  <div className="h-full bg-blue-500 w-1/3" />
                </div>
              </div>

              {/* Notes & Transcript */}
              <div className="p-6 overflow-y-auto space-y-4 text-xs text-slate-700">
                <div>
                  <h5 className="font-bold text-slate-900 text-sm mb-1">Guide Synopsis</h5>
                  <p className="leading-relaxed text-slate-600">{activeVideo.description}</p>
                </div>

                <div className="bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <h5 className="font-bold text-slate-900 mb-2 uppercase tracking-wider text-[11px] text-blue-900">
                    Step-by-Step Chapters Covered
                  </h5>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    {activeVideo.topics.map((t, idx) => (
                      <div key={idx} className="flex items-start gap-2 bg-white p-2.5 rounded-lg border border-slate-200">
                        <span className="font-mono text-blue-700 font-bold">0{idx + 1}.</span>
                        <span className="text-slate-700">{t}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {/* Footer */}
              <div className="p-4 bg-slate-50 border-t border-slate-200 flex justify-end">
                <button
                  onClick={handleClose}
                  className="px-5 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold cursor-pointer"
                >
                  Close Player
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>
  );
};
