// Cloudflare Pages Function: /api/video/stream-token
// Purpose: Verifies customer access and generates a secure Cloudflare Stream playback token

interface Env {
  DB?: any;
  CLOUDFLARE_STREAM_ACCOUNT_ID?: string;
  CLOUDFLARE_STREAM_API_TOKEN?: string;
  ADMIN_SECRET_TOKEN?: string;
  [key: string]: any;
}

// Simple Web Crypto HMAC-SHA256 signature verification
async function verifySignature(payload: string, signature: string, secret: string): Promise<boolean> {
  const enc = new TextEncoder();
  const key = await crypto.subtle.importKey(
    'raw',
    enc.encode(secret),
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['sign']
  );
  const expectedSigBytes = await crypto.subtle.sign('HMAC', key, enc.encode(payload));
  const expectedSig = Array.from(new Uint8Array(expectedSigBytes))
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');
  return expectedSig === signature;
}

export async function onRequestPost(context: { request: Request; env: Env }): Promise<Response> {
  const { request, env } = context;

  const corsHeaders = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    'Content-Type': 'application/json',
  };

  try {
    const body = await request.json().catch(() => ({}));
    const { videoId, customerPhone, sessionToken } = body as {
      videoId?: string;
      customerPhone?: string;
      sessionToken?: string;
    };

    if (!videoId) {
      return new Response(
        JSON.stringify({
          authorized: false,
          error: 'videoId is required.',
        }),
        { status: 400, headers: corsHeaders }
      );
    }

    // Step 1: Check if the video is Free or Premium
    let isPremium = true;
    let streamVideoId = '';
    let youtubeUrl: string | undefined;

    if (env.DB) {
      try {
        const videoRecord = await env.DB.prepare(
          'SELECT access_type, is_premium, stream_video_id, youtube_url FROM videos WHERE id = ?'
        )
          .bind(videoId)
          .first();

        if (videoRecord) {
          isPremium = videoRecord.access_type === 'premium' || Boolean(videoRecord.is_premium);
          streamVideoId = videoRecord.stream_video_id || '';
          youtubeUrl = videoRecord.youtube_url;
        }
      } catch (dbErr) {
        console.warn('D1 video lookup warning:', dbErr);
      }
    }

    // If video is free, allow playback
    if (!isPremium) {
      return new Response(
        JSON.stringify({
          authorized: true,
          accessType: 'free',
          videoId,
          youtubeUrl,
          message: 'Free video access authorized',
        }),
        { status: 200, headers: corsHeaders }
      );
    }

    // Step 2: For premium video, verify phone and entitlement
    if (!customerPhone) {
      return new Response(
        JSON.stringify({
          authorized: false,
          error: 'Please provide your registered phone number to verify video access.',
        }),
        { status: 401, headers: corsHeaders }
      );
    }

    const sanitizedPhone = customerPhone.replace(/\D/g, '').slice(-10);
    let hasAccess = false;

    // Check 2a: Session token validation if provided
    const cookieHeader = request.headers.get('Cookie') || '';
    const cookieMatch = cookieHeader.match(new RegExp(`tanshu_video_${videoId}_access=([^;]+)`));
    const tokenToValidate = sessionToken || (cookieMatch ? cookieMatch[1] : undefined);

    if (tokenToValidate && tokenToValidate.includes('.')) {
      try {
        const [b64Payload, sig] = tokenToValidate.split('.');
        const signingKey = env.ADMIN_SECRET_TOKEN || 'tanshu_secure_session_secret_2025';
        const isValid = await verifySignature(b64Payload, sig, signingKey);
        if (isValid) {
          const parsed = JSON.parse(atob(b64Payload));
          if (parsed.p === sanitizedPhone && parsed.v === videoId && (!parsed.exp || parsed.exp > Date.now())) {
            hasAccess = true;
          }
        }
      } catch (e) {
        console.warn('Session token decode error:', e);
      }
    }

    // Check 2b: D1 Database verification (checks that customer_video_access has an active, unrevoked record for this video)
    if (env.DB) {
      try {
        const accessRecord = await env.DB.prepare(
          `SELECT id, is_revoked FROM customer_video_access
           WHERE customer_phone = ? AND video_id = ? AND is_revoked = 0`
        )
          .bind(sanitizedPhone, videoId)
          .first();

        if (accessRecord) {
          hasAccess = true;
        } else if (!tokenToValidate) {
          hasAccess = false;
        }
      } catch (dbErr) {
        console.warn('D1 access check warning:', dbErr);
      }
    } else {
      // Local dev sandbox without D1: allow if phone starts with 999, has TEST, or has valid session token
      if (customerPhone.startsWith('999') || customerPhone.includes('TEST')) {
        hasAccess = true;
      }
    }

    if (!hasAccess) {
      return new Response(
        JSON.stringify({
          authorized: false,
          error: 'Access denied. You have not purchased this premium video, or your access was revoked.',
        }),
        { status: 403, headers: corsHeaders }
      );
    }

    // Step 3: Video is verified! Issue Cloudflare Stream signed token
    const accountId = env.CLOUDFLARE_STREAM_ACCOUNT_ID;
    const apiToken = env.CLOUDFLARE_STREAM_API_TOKEN;
    const targetStreamId = streamVideoId || 'mock_stream_video_id';

    let signedToken = `token_${Date.now()}_${Math.random().toString(36).substring(2, 8)}`;
    let playbackUrl = `https://customer-${accountId || 'cf'}.cloudflarestream.com/${signedToken}/manifest/video.m3u8`;

    if (accountId && apiToken && streamVideoId) {
      try {
        // Request signed token directly from Cloudflare Stream API
        const cfStreamResp = await fetch(
          `https://api.cloudflare.com/client/v4/accounts/${accountId}/stream/${streamVideoId}/token`,
          {
            method: 'POST',
            headers: {
              Authorization: `Bearer ${apiToken}`,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              exp: Math.floor(Date.now() / 1000) + 3600, // 1 hour expiration
              downloadable: false,
            }),
          }
        );

        if (cfStreamResp.ok) {
          const tokenData = await cfStreamResp.json();
          if (tokenData.result?.token) {
            signedToken = tokenData.result.token;
            playbackUrl = `https://customer-${accountId}.cloudflarestream.com/${signedToken}/manifest/video.m3u8`;
          }
        }
      } catch (streamErr) {
        console.error('Cloudflare Stream token generation error:', streamErr);
      }
    }

    return new Response(
      JSON.stringify({
        authorized: true,
        accessType: 'premium',
        videoId,
        streamVideoId: targetStreamId,
        playbackToken: signedToken,
        playbackUrl,
        expiresInSeconds: 3600,
      }),
      { status: 200, headers: corsHeaders }
    );
  } catch (err: any) {
    return new Response(
      JSON.stringify({
        authorized: false,
        error: err.message || 'Internal server error while verifying stream authorization',
      }),
      { status: 500, headers: corsHeaders }
    );
  }
}

export async function onRequestOptions(): Promise<Response> {
  return new Response(null, {
    status: 204,
    headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'POST, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type, Authorization',
    },
  });
}
