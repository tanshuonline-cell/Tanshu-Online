# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ========================================================
# TANSHU ONLINE — PREMIUM VIDEO SYSTEM CREDENTIALS
# Configure these in Cloudflare Pages Dashboard -> Settings -> Variables and Secrets
# ========================================================

# CASHFREE PAYMENTS GATEWAY
# Environment: 'SANDBOX' for testing or 'PRODUCTION' for live payments
CASHFREE_ENVIRONMENT="SANDBOX"
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"
CASHFREE_WEBHOOK_SECRET="YOUR_CASHFREE_WEBHOOK_SECRET"

# CLOUDFLARE STREAM VIDEO HOSTING
# Used to mint secure, time-limited signed playback tokens (anti-piracy)
CLOUDFLARE_STREAM_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_STREAM_API_TOKEN="YOUR_CLOUDFLARE_STREAM_API_TOKEN"
CLOUDFLARE_STREAM_SIGNING_KEY_ID="YOUR_STREAM_KEY_ID"
CLOUDFLARE_STREAM_SIGNING_KEY_PEM="YOUR_STREAM_PRIVATE_PEM"

# ADMIN DASHBOARD AUTHENTICATION & SESSION SIGNING
# Configure these in Cloudflare Pages Dashboard -> Settings -> Variables and Secrets (Encrypted)
# All three variables are strictly required. The backend will fail closed (HTTP 503) if any are missing.
#
# 1. Admin Login Username
ADMIN_USERNAME="YOUR_ADMIN_USERNAME"
#
# 2. Admin Login Password (must be a strong, unpredictable password)
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"
#
# 3. Admin Session Signing Secret (used EXCLUSIVELY for signing HMAC-SHA256 session tokens, never as a password or bearer token)
ADMIN_SECRET_TOKEN="YOUR_RANDOM_HMAC_SIGNING_SECRET_AT_LEAST_32_CHARS"
